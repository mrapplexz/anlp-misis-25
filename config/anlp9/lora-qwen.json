{
  "base_model": "Qwen/Qwen3-4B-Instruct-2507",
  "trainer": {
    "use_stateful_dataloader": true,
    "num_epochs": 1,
    "gradient_accumulation_steps": 8,
    "project_dir": "logs",
    "log_steps": 10,
    "eval_steps": 200,
    "save_steps": 200,
    "experiment_name": "lora-qwen4b-sft-8rank-att-custom-lora",
    "log_with": "aim",
    "minibatch_size": 2,
    "shuffle_train_dataset": false,
    "num_workers": 4,
    "seed": 42,
    "precision": {
      "enable_tf32": true,
      "low_precision": "no",
      "enable_amp": false
    },
    "optimizer": {
      "optimizer": "adamw",
      "weight_decay": 0.0001,
      "learning_rate": 0.00001
    },
    "scheduler": {
      "schedule": "linear_warmup",
      "warmup_steps_proportion": 0.01
    }
  },
  "lora": {
    "modules_apply_re": ".*self_attn\\.._proj.*",
    "modules_full_train": [],
    "rank": 8,
    "alpha": 8
  },
  "export_path": "data/anlp9/export-model-custom-lora",
  "use_custom_lora": true
}